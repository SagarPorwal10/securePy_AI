# ──────────────────────────────────────────────────
# SecurePy AI — Ollama Connection Configuration
# ──────────────────────────────────────────────────
# Copy this file to .env and edit the values below.
# The .env file is gitignored and never committed.
#
# Resolution priority:
#   CLI flag  >  Environment variable  >  .env  >  built-in default
#
# ──────────────────────────────────────────────────

# IP address or hostname of the machine running Ollama.
# Use 127.0.0.1 for local, or the LAN IP of your AI PC (e.g. 192.168.1.50).
OLLAMA_HOST=127.0.0.1

# Port Ollama is listening on (default: 11434).
OLLAMA_PORT=11434

# Default model to use when --model is not passed on the CLI.
# Examples: codellama:13b | deepseek-coder:6.7b | qwen2.5-coder:7b
OLLAMA_MODEL=codellama:13b

# Request timeout in seconds.
OLLAMA_TIMEOUT=180

# Connection scheme — almost always "http" for local/LAN.
# Set to "https" only if you have a reverse proxy with TLS in front of Ollama.
OLLAMA_SCHEME=http
